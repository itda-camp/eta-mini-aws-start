{
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv add *)",
      "Bash(uv sync*)",
      "Bash(npm run build)",
      "Bash(npm ci)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up*)",
      "Bash(docker compose build*)",
      "Bash(docker compose config*)",
      "Bash(docker stats --no-stream*)",
      "Bash(curl *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(pip *)",
      "Bash(pip3 *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pytest-before-commit.sh"
          }
        ]
      }
    ]
  }
}
