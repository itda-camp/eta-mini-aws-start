{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadModelsAndInput",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": ["arn:aws:s3:::${ME}-eta-models/models/*", "arn:aws:s3:::${ME}-eta-models/batch/in/*"]
    },
    {
      "Sid": "WriteResultsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${ME}-eta-models/batch/out/*"
    }
  ]
}
